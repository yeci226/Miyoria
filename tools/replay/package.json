{
  "name": "@miyoria/replay",
  "version": "0.1.0",
  "private": true,
  "description": "Plays a recorded replay log through the real conversation pipeline with a scripted LLM and reports on it",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@miyoria/source": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@miyoria/brain": "workspace:*",
    "@miyoria/gate": "workspace:*",
    "@miyoria/heart": "workspace:*",
    "@miyoria/llm": "workspace:*",
    "@miyoria/memory": "workspace:*",
    "@miyoria/runtime": "workspace:*",
    "@miyoria/store": "workspace:*",
    "@miyoria/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
