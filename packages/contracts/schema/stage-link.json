{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "@miyoria/contracts/stage-link",
  "$defs": {
    "StageLinkActivity": {
      "type": "object",
      "properties": {
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageLinkActivityKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "default": "",
          "type": "string",
          "maxLength": 40
        },
        "detail": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "progress": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "elapsed_ms": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_ms": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        },
        "secondary": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageLinkActivitySide"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "StageLinkActivityKind": {
      "type": "string",
      "enum": [
        "thinking",
        "synthesizing",
        "tool",
        "game",
        "song_prepare",
        "singing"
      ]
    },
    "StageLinkActivityMessage": {
      "type": "object",
      "properties": {
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageLinkActivityKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "default": "",
          "type": "string",
          "maxLength": 40
        },
        "detail": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "progress": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "elapsed_ms": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_ms": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        },
        "secondary": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageLinkActivitySide"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "type": "string",
          "const": "activity"
        }
      },
      "required": [
        "kind",
        "type"
      ]
    },
    "StageLinkActivitySide": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 40
        },
        "detail": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "progress": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "label"
      ]
    },
    "StageLinkAvatarExpressionMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "avatar_expression"
        },
        "expression": {
          "$ref": "#/$defs/StageLinkGiftExpression"
        },
        "seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 15
        },
        "id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "expression",
        "seconds"
      ]
    },
    "StageLinkAvatarHotkeyMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "avatar_hotkey"
        },
        "name": {
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "name"
      ]
    },
    "StageLinkBeatMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "beat"
        },
        "song": {
          "type": "string",
          "maxLength": 128
        },
        "bpm": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "times_ms": {
          "maxItems": 2000,
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 86400000
          }
        },
        "offset_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400000
        }
      },
      "required": [
        "type",
        "song",
        "bpm",
        "times_ms",
        "offset_ms"
      ]
    },
    "StageLinkClipMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "clip"
        },
        "reason": {
          "type": "string",
          "maxLength": 120
        },
        "id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "reason"
      ]
    },
    "StageLinkClipSavedMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "clip_saved"
        },
        "reason": {
          "type": "string",
          "maxLength": 120
        },
        "path": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "required": [
        "type",
        "reason",
        "path"
      ]
    },
    "StageLinkCoreMessage": {
      "oneOf": [
        {
          "$ref": "#/$defs/StageLinkWelcomeMessage"
        },
        {
          "$ref": "#/$defs/StageLinkEmotionMessage"
        },
        {
          "$ref": "#/$defs/StageLinkSubtitleMessage"
        },
        {
          "$ref": "#/$defs/StageLinkSpeakingMessage"
        },
        {
          "$ref": "#/$defs/StageLinkSceneMessage"
        },
        {
          "$ref": "#/$defs/StageLinkStreamMessage"
        },
        {
          "$ref": "#/$defs/StageLinkAvatarHotkeyMessage"
        },
        {
          "$ref": "#/$defs/StageLinkGazeMessage"
        },
        {
          "$ref": "#/$defs/StageLinkAvatarExpressionMessage"
        },
        {
          "$ref": "#/$defs/StageLinkGiftMessage"
        },
        {
          "$ref": "#/$defs/StageLinkScreenMessage"
        },
        {
          "$ref": "#/$defs/StageLinkDanmakuMessage"
        },
        {
          "$ref": "#/$defs/StageLinkDanmakuClearMessage"
        },
        {
          "$ref": "#/$defs/StageLinkTouchMessage"
        },
        {
          "$ref": "#/$defs/StageLinkSongVideoMessage"
        },
        {
          "$ref": "#/$defs/StageLinkBeatMessage"
        },
        {
          "$ref": "#/$defs/StageLinkClipMessage"
        },
        {
          "$ref": "#/$defs/StageLinkNoticeMessage"
        },
        {
          "$ref": "#/$defs/StageLinkActivityMessage"
        },
        {
          "$ref": "#/$defs/StageLinkKaraokeMessage"
        },
        {
          "$ref": "#/$defs/StageLinkKaraokeLyricsMessage"
        },
        {
          "$ref": "#/$defs/StageLinkKaraokeVoiceMessage"
        },
        {
          "$ref": "#/$defs/StageLinkStatusRequestMessage"
        },
        {
          "$ref": "#/$defs/StageLinkPingMessage"
        },
        {
          "$ref": "#/$defs/StageLinkPongMessage"
        }
      ]
    },
    "StageLinkDanmakuClearMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "danmaku_clear"
        }
      },
      "required": [
        "type"
      ]
    },
    "StageLinkDanmakuDoneMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "danmaku_done"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "outcome": {
          "$ref": "#/$defs/StageLinkDanmakuOutcome"
        }
      },
      "required": [
        "type",
        "id",
        "outcome"
      ]
    },
    "StageLinkDanmakuMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "danmaku"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "max_on_screen": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "queue_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "max_wait_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      },
      "required": [
        "type",
        "id",
        "name",
        "text",
        "max_on_screen",
        "queue_max",
        "max_wait_ms"
      ]
    },
    "StageLinkDanmakuOutcome": {
      "type": "string",
      "enum": [
        "shown",
        "no_overlay",
        "queue_full",
        "too_late",
        "cleared",
        "lost"
      ]
    },
    "StageLinkEmotionMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "emotion"
        },
        "name": {
          "type": "string"
        },
        "intensity": {
          "type": "number"
        },
        "resting": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "name",
        "intensity"
      ]
    },
    "StageLinkErrorMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "message": {
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "message"
      ]
    },
    "StageLinkGazeMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "gaze"
        },
        "target": {
          "$ref": "#/$defs/StageLinkGazeTarget"
        }
      },
      "required": [
        "type",
        "target"
      ]
    },
    "StageLinkGazeTarget": {
      "type": "string",
      "enum": [
        "chat",
        "game",
        "camera"
      ]
    },
    "StageLinkGiftExpression": {
      "type": "string",
      "enum": [
        "heart",
        "blush",
        "squint",
        "big_bowl"
      ]
    },
    "StageLinkGiftMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "gift"
        },
        "name": {
          "type": "string",
          "maxLength": 32
        },
        "item": {
          "type": "string",
          "maxLength": 32
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "label": {
          "type": "string",
          "maxLength": 24
        }
      },
      "required": [
        "type",
        "name",
        "item",
        "count",
        "label"
      ]
    },
    "StageLinkHelloMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "token": {
          "type": "string"
        },
        "node": {
          "default": "",
          "type": "string"
        },
        "capabilities": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "version",
        "token"
      ]
    },
    "StageLinkKaraokeAir": {
      "type": "object",
      "properties": {
        "backing": {
          "type": "boolean"
        },
        "relay": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 60
            },
            {
              "type": "null"
            }
          ]
        },
        "delay_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "backing_gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "voice_gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "duck_gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "backing",
        "relay",
        "delay_ms",
        "backing_gain",
        "voice_gain",
        "duck_gain"
      ]
    },
    "StageLinkKaraokeBacking": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 1024
        },
        "format": {
          "type": "string",
          "enum": [
            "pcm",
            "m4a"
          ]
        },
        "rate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000
        }
      },
      "required": [
        "path",
        "format",
        "rate"
      ]
    },
    "StageLinkKaraokeCheer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 32
        },
        "kind": {
          "type": "string",
          "enum": [
            "cheer",
            "nice",
            "wow",
            "encore"
          ]
        },
        "to": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 60
            },
            "color": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            }
          },
          "required": [
            "name",
            "color"
          ]
        },
        "by": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 60
            },
            "color": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            }
          },
          "required": [
            "name",
            "color"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "to",
        "by"
      ]
    },
    "StageLinkKaraokeLine": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 60
        },
        "color": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "rank": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "total": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 110
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "voice",
                "estimate"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "move": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "same"
          ]
        },
        "winner": {
          "type": "boolean"
        },
        "coins": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "finished": {
          "type": "boolean"
        },
        "on_air": {
          "type": "boolean"
        },
        "parts": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "pitch": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "stability": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "rhythm": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "expression": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "pitch",
                "stability",
                "rhythm",
                "expression"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "pitch": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "from": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "track": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "from",
                "track"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "cheers": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "name",
        "color",
        "rank",
        "total",
        "source",
        "move",
        "winner",
        "coins",
        "finished",
        "on_air"
      ]
    },
    "StageLinkKaraokeLyrics": {
      "type": "object",
      "properties": {
        "room": {
          "type": "string",
          "maxLength": 12
        },
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "song": {
          "type": "string",
          "maxLength": 128
        },
        "lyrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkersKaraokeLyricsV2"
            },
            {
              "type": "null"
            }
          ]
        },
        "video": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "backing": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageLinkKaraokeBacking"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "default": [],
          "maxItems": 8000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "midi": {
                "type": "number"
              }
            },
            "required": [
              "start",
              "end",
              "midi"
            ]
          }
        }
      },
      "required": [
        "room",
        "round",
        "song",
        "lyrics",
        "video",
        "backing"
      ]
    },
    "StageLinkKaraokeLyricsMessage": {
      "type": "object",
      "properties": {
        "room": {
          "type": "string",
          "maxLength": 12
        },
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "song": {
          "type": "string",
          "maxLength": 128
        },
        "lyrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkersKaraokeLyricsV2"
            },
            {
              "type": "null"
            }
          ]
        },
        "video": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "backing": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageLinkKaraokeBacking"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "default": [],
          "maxItems": 8000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "midi": {
                "type": "number"
              }
            },
            "required": [
              "start",
              "end",
              "midi"
            ]
          }
        },
        "type": {
          "type": "string",
          "const": "karaoke_lyrics"
        }
      },
      "required": [
        "room",
        "round",
        "song",
        "lyrics",
        "video",
        "backing",
        "type"
      ]
    },
    "StageLinkKaraokeMember": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 60
        },
        "color": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "role": {
          "type": "string",
          "enum": [
            "singer",
            "spectator"
          ]
