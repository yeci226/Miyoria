{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "@miyoria/contracts/stage-link",
  "$defs": {
    "StageLinkActivity": {
      "type": "object",
      "properties": {
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageLinkActivityKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "default": "",
          "type": "string",
          "maxLength": 40
        },
        "detail": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "progress": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "elapsed_ms": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_ms": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "StageLinkActivityKind": {
      "type": "string",
      "enum": [
        "thinking",
        "synthesizing",
        "song_prepare",
        "singing"
      ]
    },
    "StageLinkActivityMessage": {
      "type": "object",
      "properties": {
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageLinkActivityKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "default": "",
          "type": "string",
          "maxLength": 40
        },
        "detail": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "progress": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "elapsed_ms": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_ms": {
          "default": null,
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "type": "string",
          "const": "activity"
        }
      },
      "required": [
        "kind",
        "type"
      ]
    },
    "StageLinkAvatarExpressionMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "avatar_expression"
        },
        "expression": {
          "$ref": "#/$defs/StageLinkGiftExpression"
        },
        "seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 15
        },
        "id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "expression",
        "seconds"
      ]
    },
    "StageLinkAvatarHotkeyMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "avatar_hotkey"
        },
        "name": {
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "name"
      ]
    },
    "StageLinkBeatMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "beat"
        },
        "song": {
          "type": "string",
          "maxLength": 128
        },
        "bpm": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "times_ms": {
          "maxItems": 2000,
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 86400000
          }
        },
        "offset_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400000
        }
      },
      "required": [
        "type",
        "song",
        "bpm",
        "times_ms",
        "offset_ms"
      ]
    },
    "StageLinkClipMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "clip"
        },
        "reason": {
          "type": "string",
          "maxLength": 120
        },
        "id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "reason"
      ]
    },
    "StageLinkClipSavedMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "clip_saved"
        },
        "reason": {
          "type": "string",
          "maxLength": 120
        },
        "path": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "required": [
        "type",
        "reason",
        "path"
      ]
    },
    "StageLinkCoreMessage": {
      "oneOf": [
        {
          "$ref": "#/$defs/StageLinkWelcomeMessage"
        },
        {
          "$ref": "#/$defs/StageLinkEmotionMessage"
        },
        {
          "$ref": "#/$defs/StageLinkSubtitleMessage"
        },
        {
          "$ref": "#/$defs/StageLinkSpeakingMessage"
        },
        {
          "$ref": "#/$defs/StageLinkSceneMessage"
        },
        {
          "$ref": "#/$defs/StageLinkStreamMessage"
        },
        {
          "$ref": "#/$defs/StageLinkAvatarHotkeyMessage"
        },
        {
          "$ref": "#/$defs/StageLinkGazeMessage"
        },
        {
          "$ref": "#/$defs/StageLinkAvatarExpressionMessage"
        },
        {
          "$ref": "#/$defs/StageLinkGiftMessage"
        },
        {
          "$ref": "#/$defs/StageLinkScreenMessage"
        },
        {
          "$ref": "#/$defs/StageLinkTouchMessage"
        },
        {
          "$ref": "#/$defs/StageLinkSongVideoMessage"
        },
        {
          "$ref": "#/$defs/StageLinkBeatMessage"
        },
        {
          "$ref": "#/$defs/StageLinkClipMessage"
        },
        {
          "$ref": "#/$defs/StageLinkNoticeMessage"
        },
        {
          "$ref": "#/$defs/StageLinkActivityMessage"
        },
        {
          "$ref": "#/$defs/StageLinkStatusRequestMessage"
        },
        {
          "$ref": "#/$defs/StageLinkPingMessage"
        },
        {
          "$ref": "#/$defs/StageLinkPongMessage"
        }
      ]
    },
    "StageLinkEmotionMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "emotion"
        },
        "name": {
          "type": "string"
        },
        "intensity": {
          "type": "number"
        },
        "resting": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "name",
        "intensity"
      ]
    },
    "StageLinkErrorMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "message": {
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "message"
      ]
    },
    "StageLinkGazeMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "gaze"
        },
        "target": {
          "$ref": "#/$defs/StageLinkGazeTarget"
        }
      },
      "required": [
        "type",
        "target"
      ]
    },
    "StageLinkGazeTarget": {
      "type": "string",
      "enum": [
        "chat",
        "game",
        "camera"
      ]
    },
    "StageLinkGiftExpression": {
      "type": "string",
      "enum": [
        "heart",
        "blush",
        "squint",
        "big_bowl"
      ]
    },
    "StageLinkGiftMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "gift"
        },
        "name": {
          "type": "string",
          "maxLength": 32
        },
        "item": {
          "type": "string",
          "maxLength": 32
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "label": {
          "type": "string",
          "maxLength": 24
        }
      },
      "required": [
        "type",
        "name",
        "item",
        "count",
        "label"
      ]
    },
    "StageLinkHelloMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "token": {
          "type": "string"
        },
        "node": {
          "default": "",
          "type": "string"
        },
        "capabilities": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "version",
        "token"
      ]
    },
    "StageLinkLevelFrame": {
      "type": "object",
      "properties": {
        "t": {
          "type": "number"
        },
        "rms": {
          "type": "number"
        },
        "bands": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "rms"
      ]
    },
    "StageLinkNoticeMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "notice"
        },
        "text": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "type",
        "text"
      ]
    },
    "StageLinkPingMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ping"
        }
      },
      "required": [
        "type"
      ]
    },
    "StageLinkPongMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "pong"
        }
      },
      "required": [
        "type"
      ]
    },
    "StageLinkSceneMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "scene"
        },
        "name": {
          "type": "string"
        },
        "transition": {
          "type": [
            "string",
            "null"
          ]
        },
        "transition_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 20000
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "name"
      ]
    },
    "StageLinkScreenKind": {
      "type": "string",
      "enum": [
        "message",
        "dedication"
      ]
    },
    "StageLinkScreenMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "screen"
        },
        "kind": {
          "$ref": "#/$defs/StageLinkScreenKind"
        },
        "name": {
          "type": "string",
          "maxLength": 32
        },
        "text": {
          "type": "string",
          "maxLength": 200
        },
        "song": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "kind",
        "name",
        "text",
        "song"
      ]
    },
    "StageLinkSongVideoAction": {
      "type": "string",
      "enum": [
        "play",
        "stop"
      ]
    },
    "StageLinkSongVideoMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "song_video"
        },
        "action": {
          "$ref": "#/$defs/StageLinkSongVideoAction"
        },
        "song": {
          "type": "string",
          "maxLength": 128
        },
        "path": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "offset_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        },
        "scene": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "action",
        "song"
      ]
    },
    "StageLinkSpeakingMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "speaking"
        },
        "state": {
          "$ref": "#/$defs/StageLinkSpeakingState"
        }
      },
      "required": [
        "type",
        "state"
      ]
    },
    "StageLinkSpeakingState": {
      "type": "string",
      "enum": [
        "started",
        "stopped"
      ]
    },
    "StageLinkStageMessage": {
      "oneOf": [
        {
          "$ref": "#/$defs/StageLinkHelloMessage"
        },
        {
          "$ref": "#/$defs/StageLinkStatusMessage"
        },
        {
          "$ref": "#/$defs/StageLinkErrorMessage"
        },
        {
          "$ref": "#/$defs/StageLinkClipSavedMessage"
        },
        {
          "$ref": "#/$defs/StageLinkPingMessage"
        },
        {
          "$ref": "#/$defs/StageLinkPongMessage"
        }
      ]
    },
    "StageLinkStageStatus": {
      "type": "object",
      "properties": {
        "vts": {
          "default": false,
          "type": "boolean"
        },
        "obs": {
          "default": false,
          "type": "boolean"
        },
        "scene": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "streaming": {
          "default": false,
          "type": "boolean"
        },
        "scenes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hotkeys": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overlay_url": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "StageLinkStatusMessage": {
      "type": "object",
      "properties": {
        "vts": {
          "default": false,
          "type": "boolean"
        },
        "obs": {
          "default": false,
          "type": "boolean"
        },
        "scene": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "streaming": {
          "default": false,
          "type": "boolean"
        },
        "scenes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hotkeys": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overlay_url": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": "string",
          "const": "status"
        },
        "id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type"
      ]
    },
    "StageLinkStatusRequestMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "status_request"
        },
        "id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type"
      ]
    },
    "StageLinkStreamAction": {
      "type": "string",
      "enum": [
        "start",
        "stop"
      ]
    },
    "StageLinkStreamMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "stream"
        },
        "action": {
          "$ref": "#/$defs/StageLinkStreamAction"
        },
        "id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "action"
      ]
    },
    "StageLinkSubtitleMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "subtitle"
        },
        "turn": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "final": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "turn",
        "text",
        "final"
      ]
    },
    "StageLinkTouchMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "touch"
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "part": {
          "$ref": "#/$defs/StageLinkTouchPart"
        }
      },
      "required": [
        "type",
        "x",
        "y",
        "part"
      ]
    },
    "StageLinkTouchPart": {
      "type": "string",
      "enum": [
        "head",
        "face",
        "body",
        "screen"
      ]
    },
    "StageLinkWelcomeMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "welcome"
        },
        "session": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "session"
      ]
    }
  }
}
