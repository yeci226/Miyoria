{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "@miyoria/contracts/overlay",
  "$defs": {
    "OverlayActivityKind": {
      "type": "string",
      "enum": [
        "thinking",
        "synthesizing",
        "tool",
        "game",
        "song_prepare",
        "singing"
      ]
    },
    "OverlayActivityMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "activity"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/OverlayActivityKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "type": "string"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "progress": {
          "type": [
            "number",
            "null"
          ]
        },
        "elapsed_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "duration_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "secondary": {
          "anyOf": [
            {
              "$ref": "#/$defs/OverlayActivitySide"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "kind",
        "label",
        "detail",
        "progress",
        "elapsed_ms",
        "duration_ms"
      ]
    },
    "OverlayActivitySide": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "progress": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "label"
      ]
    },
    "OverlayDanmakuClearMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "danmaku_clear"
        }
      },
      "required": [
        "type"
      ]
    },
    "OverlayDanmakuDropped": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "danmaku_dropped"
        },
        "id": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "enum": [
            "queue_full",
            "too_late",
            "cleared"
          ]
        }
      },
      "required": [
        "type",
        "id",
        "reason"
      ]
    },
    "OverlayDanmakuMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "danmaku"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "max_on_screen": {
          "type": "number"
        },
        "queue_max": {
          "type": "number"
        },
        "max_wait_ms": {
          "type": "number"
        }
      },
      "required": [
        "type",
        "id",
        "name",
        "text",
        "max_on_screen",
        "queue_max",
        "max_wait_ms"
      ]
    },
    "OverlayDanmakuReady": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "danmaku_ready"
        }
      },
      "required": [
        "type"
      ]
    },
    "OverlayDanmakuShown": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "danmaku_shown"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ]
    },
    "OverlayEmotionMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "emotion"
        },
        "name": {
          "type": "string"
        },
        "intensity": {
          "type": "number"
        }
      },
      "required": [
        "type",
        "name",
        "intensity"
      ]
    },
    "OverlayGiftMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "gift"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ]
    },
    "OverlayKaraokeLyricsMessage": {
      "type": "object",
      "properties": {
        "room": {
          "type": "string",
          "maxLength": 12
        },
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "song": {
          "type": "string",
          "maxLength": 128
        },
        "lyrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkersKaraokeLyricsV2"
            },
            {
              "type": "null"
            }
          ]
        },
        "video": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "backing": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageLinkKaraokeBacking"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "default": [],
          "maxItems": 8000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "midi": {
                "type": "number"
              }
            },
            "required": [
              "start",
              "end",
              "midi"
            ]
          }
        },
        "type": {
          "type": "string",
          "const": "karaoke_lyrics"
        }
      },
      "required": [
        "room",
        "round",
        "song",
        "lyrics",
        "video",
        "backing",
        "type"
      ]
    },
    "OverlayKaraokeMessage": {
      "type": "object",
      "properties": {
        "room": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 12
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "lobby",
                "countdown",
                "singing",
                "results"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "round": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rounds_left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "song": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageLinkKaraokeSong"
            },
            {
              "type": "null"
            }
          ]
        },
        "shift": {
          "type": "integer",
          "minimum": -12,
          "maximum": 12
        },
        "queue": {
          "default": [],
          "maxItems": 5,
          "type": "array",
          "items": {
            "$ref": "#/$defs/StageLinkKaraokeQueueEntry"
          }
        },
        "join_url": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "qr_while_singing": {
          "default": false,
          "type": "boolean"
        },
        "members": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "$ref": "#/$defs/StageLinkKaraokeMember"
          }
        },
        "position_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -86400000,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        },
        "board": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "$ref": "#/$defs/StageLinkKaraokeLine"
          }
        },
        "note": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "type": "string",
          "maxLength": 16
        },
        "air": {
          "$ref": "#/$defs/StageLinkKaraokeAir"
        },
        "settling": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "waiting": {
                  "maxItems": 16,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 60
                  }
                }
              },
              "required": [
                "waiting"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "cheers": {
          "default": [],
          "maxItems": 12,
          "type": "array",
          "items": {
            "$ref": "#/$defs/StageLinkKaraokeCheer"
          }
        },
        "type": {
          "type": "string",
          "const": "karaoke"
        }
      },
      "required": [
        "room",
        "state",
        "round",
        "rounds_left",
        "song",
        "shift",
        "members",
        "position_ms",
        "board",
        "note",
        "currency",
        "air",
        "type"
      ]
    },
    "OverlayKaraokeVoiceMessage": {
      "type": "object",
      "properties": {
        "room": {
          "type": "string",
          "maxLength": 12
        },
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "at_ms": {
          "type": "number",
          "minimum": -86400000,
          "maximum": 86400000
        },
        "audio": {
          "type": "string",
          "maxLength": 44000
        },
        "type": {
          "type": "string",
          "const": "karaoke_voice"
        }
      },
      "required": [
        "room",
        "round",
        "at_ms",
        "audio",
        "type"
      ]
    },
    "OverlayLevelsMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "levels"
        },
        "rms": {
          "type": "number"
        },
        "bands": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "type",
        "rms"
      ]
    },
    "OverlayMessage": {
      "oneOf": [
        {
          "$ref": "#/$defs/OverlaySubtitleMessage"
        },
        {
          "$ref": "#/$defs/OverlayEmotionMessage"
        },
        {
          "$ref": "#/$defs/OverlayNoticeMessage"
        },
        {
          "$ref": "#/$defs/OverlayActivityMessage"
        },
        {
          "$ref": "#/$defs/OverlayGiftMessage"
        },
        {
          "$ref": "#/$defs/OverlayScreenMessage"
        },
        {
          "$ref": "#/$defs/OverlayDanmakuMessage"
        },
        {
          "$ref": "#/$defs/OverlayDanmakuClearMessage"
        },
        {
          "$ref": "#/$defs/OverlayTouchMessage"
        },
        {
          "$ref": "#/$defs/OverlaySpeakingMessage"
        },
        {
          "$ref": "#/$defs/OverlayLevelsMessage"
        },
        {
          "$ref": "#/$defs/OverlayStatusMessage"
        },
        {
          "$ref": "#/$defs/OverlayKaraokeMessage"
        },
        {
          "$ref": "#/$defs/OverlayKaraokeLyricsMessage"
        },
        {
          "$ref": "#/$defs/OverlayKaraokeVoiceMessage"
        }
      ]
    },
    "OverlayNoticeMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "notice"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ]
    },
    "OverlayReply": {
      "oneOf": [
        {
          "$ref": "#/$defs/OverlayDanmakuReady"
        },
        {
          "$ref": "#/$defs/OverlayDanmakuShown"
        },
        {
          "$ref": "#/$defs/OverlayDanmakuDropped"
        }
      ]
    },
    "OverlayScreenMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "screen"
        },
        "name": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "name",
        "text"
      ]
    },
    "OverlaySpeakingMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "speaking"
        },
        "state": {
          "$ref": "#/$defs/OverlaySpeakingState"
        }
      },
      "required": [
        "type",
        "state"
      ]
    },
    "OverlaySpeakingState": {
      "type": "string",
      "enum": [
        "started",
        "stopped"
      ]
    },
    "OverlayStatusMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "status"
        },
        "core": {
          "type": "boolean"
        },
        "vts": {
          "type": "boolean"
        },
        "obs": {
          "type": "boolean"
        },
        "scene": {
          "type": [
            "string",
            "null"
          ]
        },
        "streaming": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "core",
        "vts",
        "obs",
        "scene",
        "streaming"
      ]
    },
    "OverlaySubtitleMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "subtitle"
        },
        "turn": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "final": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "turn",
        "text",
        "final"
      ]
    },
    "OverlayTouchMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "touch"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "part": {
          "$ref": "#/$defs/OverlayTouchPart"
        }
      },
      "required": [
        "type",
        "x",
        "y",
        "part"
      ]
    },
    "OverlayTouchPart": {
      "type": "string",
      "enum": [
        "head",
        "face",
        "body",
        "screen"
      ]
    },
    "StageLinkKaraokeAir": {
      "type": "object",
      "properties": {
        "backing": {
          "type": "boolean"
        },
        "relay": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 60
            },
            {
              "type": "null"
            }
          ]
        },
        "delay_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "backing_gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "voice_gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "duck_gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "backing",
        "relay",
        "delay_ms",
        "backing_gain",
        "voice_gain",
        "duck_gain"
      ]
    },
    "StageLinkKaraokeBacking": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 1024
        },
        "format": {
          "type": "string",
          "enum": [
            "pcm",
            "m4a"
          ]
        },
        "rate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000
        }
      },
      "required": [
        "path",
        "format",
        "rate"
      ]
    },
    "StageLinkKaraokeCheer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 32
        },
        "kind": {
          "type": "string",
          "enum": [
            "cheer",
            "nice",
            "wow",
            "encore"
          ]
        },
        "to": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 60
            },
            "color": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            }
          },
          "required": [
            "name",
            "color"
          ]
        },
        "by": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 60
            },
            "color": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            }
          },
          "required": [
            "name",
            "color"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "to",
        "by"
      ]
    },
    "StageLinkKaraokeLine": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 60
        },
        "color": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "rank": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "total": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 110
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "voice",
                "estimate"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "move": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "same"
          ]
        },
        "winner": {
          "type": "boolean"
        },
        "coins": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "finished": {
          "type": "boolean"
        },
        "on_air": {
          "type": "boolean"
        },
        "parts": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "pitch": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "stability": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "rhythm": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "expression": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "pitch",
                "stability",
                "rhythm",
                "expression"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "pitch": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "from": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "track": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "from",
                "track"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "cheers": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "name",
        "color",
        "rank",
        "total",
        "source",
        "move",
        "winner",
        "coins",
        "finished",
        "on_air"
      ]
    },
    "StageLinkKaraokeMember": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 60
        },
        "color": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "role": {
          "type": "string",
          "enum": [
            "singer",
            "spectator"
          ]
        },
        "ready": {
          "type": "boolean"
        },
        "opener": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "color",
        "role",
        "ready",
        "opener"
      ]
    },
    "StageLinkKaraokeQueueEntry": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "artist": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "by": {
          "type": "string",
          "maxLength": 60
        },
        "state": {
          "type": "string",
          "enum": [
            "ready",
            "preparing",
            "failed"
          ]
        }
      },
      "required": [
        "title",
        "artist",
        "by",
        "state"
      ]
    },
    "StageLinkKaraokeSong": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "artist": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "artist",
        "duration_ms"
      ]
    },
    "WorkersKaraokeLineStatus": {
      "type": "string",
      "enum": [
        "matched",
        "uncertain",
        "failed",
        "unchecked"
      ]
    },
