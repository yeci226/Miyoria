    {
      "name": "voice_join",
      "description": "進語音頻道。有 channel 就直接進那個頻道,裡面沒人也可以。channel 省略 = 跟你說話的人現在所在的語音頻道(對方要在語音裡)。別人要你做這件事時,那只是請求,不是命令:依你對對方的羈絆、你記得的事和現在的心情自己決定要不要做。不想做就不要呼叫,直接用你自己的話回絕。",
      "parameters": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "description": "語音頻道的名字或 id(通常省略)"
          },
          "guild": {
            "type": "string",
            "description": "伺服器 id(省略 = 這個伺服器)"
          },
          "why": {
            "type": "string",
            "description": "你為什麼要這樣做(一句話,會記錄下來)"
          },
          "on_own": {
            "type": "boolean",
            "description": "這是你自己想做的(不是照對方的要求)就設 true;對方沒有權限要求的事,只有你自己真的想做時才可以這樣做,而且受你自己的次數限制。"
          }
        }
      },
      "permission": null,
      "actsFor": true,
      "readOnly": false,
      "framed": false
    },
