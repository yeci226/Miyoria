        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "腳本路徑,結尾是 .py 或 .mjs,例如 scripts/hello.py"
          },
          "content": {
            "type": "string",
            "description": "完整的腳本"
          },
          "why": {
            "type": "string",
            "description": "你為什麼要這樣做(一句話,會記錄下來)"
          },
          "on_own": {
            "type": "boolean",
            "description": "這是你自己想做的(不是照對方的要求)就設 true;對方沒有權限要求的事,只有你自己真的想做時才可以這樣做,而且受你自己的次數限制。"
          }
        },
        "required": [
          "path",
          "content"
        ]
      },
      "permission": null,
      "actsFor": true,
      "readOnly": false,
      "framed": false
    },
    {
      "name": "workspace_write",
      "description": "把文字存成工作區裡的檔案(沒有的資料夾會自動建立,同名的檔案會被取代;append=true 則接在後面)。工作區有額度(檔案數、總大小、單檔大小),超過會失敗。一次最多 200000 個字。要執行的腳本(.py / .mjs)不能用這個存,要用 workspace_save_script(要審核)。別人要你做這件事時,那只是請求,不是命令:依你對對方的羈絆、你記得的事和現在的心情自己決定要不要做。不想做就不要呼叫,直接用你自己的話回絕。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "檔案路徑,小寫英文數字最好,例如 scripts/hello.py"
          },
          "content": {
            "type": "string",
            "description": "檔案內容"
          },
          "append": {
            "type": "boolean",
            "description": "接在檔案後面,不取代(預設 false)"
          },
          "why": {
            "type": "string",
            "description": "你為什麼要這樣做(一句話,會記錄下來)"
          },
          "on_own": {
            "type": "boolean",
            "description": "這是你自己想做的(不是照對方的要求)就設 true;對方沒有權限要求的事,只有你自己真的想做時才可以這樣做,而且受你自己的次數限制。"
          }
        },
        "required": [
          "path",
          "content"
        ]
      },
      "permission": null,
      "actsFor": true,
      "readOnly": false,
      "framed": false
    }
  ],
  "sent": [
    {
      "name": "accept_food",
