          "task": {
            "type": "string",
            "maxLength": 60,
            "description": "要做什麼"
          },
          "reward": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "獎金"
          },
          "why": {
            "type": "string",
