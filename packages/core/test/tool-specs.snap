        ]
      },
      "permission": null,
      "actsFor": false,
      "readOnly": false,
      "framed": false
    },
    {
      "name": "knowledge_note",
      "description": "整理你自己的資料庫(關於人、這個伺服器、你取名的主題)。結構由你決定:新增文件、用 JSON Patch 修改欄位、改名、刪除或合併。參考資料「你整理的資料」裡有文件代號(#xxxxxx)。別人告訴你的事會記成「他說的」;別人寫的欄位只有他自己能改,關於你自己的文件只能在你自己反思時改。",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "patch",
              "retitle",
              "delete",
              "merge"
            ]
          },
          "subject": {
            "type": "string",
            "description": "create 用:speaker(正在跟你說話的人)、server(這個伺服器)或 topic:主題名"
          },
          "kind": {
            "type": "string",
            "description": "文件種類,你自己取(例如 人物卡、內梗、建築計畫)"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "object",
            "description": "create 用:文件內容(任意 JSON,文字可以用 Markdown)"
          },
          "doc": {
            "type": "string",
            "description": "要改的文件代號,例如 #a1b2c3"
          },
          "into": {
            "type": "string",
            "description": "merge:合併到哪份文件"
          },
          "path": {
            "type": "string",
            "description": "merge:放在哪個欄位(JSON Pointer)"
          },
          "ops": {
            "type": "array",
            "description": "patch 用:JSON Patch 操作",
            "items": {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "enum": [
                    "add",
                    "replace",
                    "remove",
                    "move"
                  ]
                },
                "path": {
                  "type": "string",
                  "description": "JSON Pointer,例如 /喜歡/- 或 /最近在忙"
                },
                "from": {
                  "type": "string"
                },
                "value": {}
              },
              "required": [
                "op",
                "path"
              ]
            }
          },
          "why": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ]
      },
      "permission": null,
      "actsFor": false,
      "readOnly": false,
      "framed": false
    },
