            "type": "string",
            "description": "遊戲 id,例如 minecraft"
          },
          "where": {
            "type": "string",
            "enum": [
              "auto",
              "voice",
              "here",
              "stream"
            ],
            "description": "實況送到哪裡,通常省略(auto)"
          },
