{
  "name": "@miyoria/cluster",
  "version": "0.1.0",
  "description": "The cluster module of Core: the control link hosts dial, the hosts that joined, and the registry of service endpoints",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@miyoria/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@miyoria/contracts": "workspace:*",
    "@miyoria/runtime": "workspace:*",
    "@miyoria/sdk": "workspace:*",
    "@miyoria/store": "workspace:*",
    "@miyoria/types": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@miyoria/hostd": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
