{
  "name": "@miyoria/hostd",
  "version": "0.1.0",
  "description": "The per-machine supervisor: runs the services a host has installed from their service.toml, probes and restarts them, and reports to Core",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@miyoria/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./link": {
      "@miyoria/source": "./src/link/index.ts",
      "types": "./dist/link/index.d.ts",
      "default": "./dist/link/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@miyoria/contracts": "workspace:*",
    "@miyoria/sdk": "workspace:*",
    "execa": "^10.2.1",
    "koffi": "^3.3.8",
    "pino": "^10.4.0",
    "rotating-file-stream": "^4.0.0",
    "smol-toml": "^1.9.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
