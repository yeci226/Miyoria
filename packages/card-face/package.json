{
  "name": "@miyoria/card-face",
  "version": "0.1.0",
  "description": "The member card as an SVG (shared by the panel and the Core's link-preview renderer)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@miyoria/source": "./src/index.tsx",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./render": {
      "@miyoria/source": "./src/render.tsx",
      "types": "./dist/render.d.ts",
      "default": "./dist/render.js"
    },
    "./fonts": {
      "@miyoria/source": "./src/fonts.ts",
      "types": "./dist/fonts.d.ts",
      "default": "./dist/fonts.js"
    },
    "./market": {
      "@miyoria/source": "./src/market.ts",
      "types": "./dist/market.d.ts",
      "default": "./dist/market.js"
    },
    "./pictures": {
      "@miyoria/source": "./src/pictures/index.ts",
      "types": "./dist/pictures/index.d.ts",
      "default": "./dist/pictures/index.js"
    }
  },
  "files": [
    "dist",
    "fonts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@miyoria/types": "workspace:*",
    "d3-hierarchy": "3.1.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uqr": "0.1.2"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
