# 由 `miyoria init` 建立。密碼類的值放這裡;.env 不要進 git。

# LLM(DeepSeek 或任何 OpenAI 相容 API)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# 模型 id 在 profiles/<id>/profile.toml 的 [llm.purposes] 設定

# Discord bot 帳號(文字 + 指令)
DISCORD_BOT_TOKEN=
# 你的 Discord user id,擁有者權限
MIYORIA_OWNER_ID=

# Admin API token(`miyoria init` 會自動產生)
MIYORIA_API_TOKEN=

# 管理面板的 Discord 登入(選用;Developer Portal → OAuth2 的 Client ID / Client Secret,
# 要在 miyoria.toml 打開 [modules.api.discord_oauth])
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Self 帳號語音節點連線用 token(`miyoria init` 會自動產生;apps/voice-node 的 .env 要填同一個)
VOICE_LINK_TOKEN=

# Stage 節點(直播機上的 `miyoria stage`)連線用 token(`miyoria init` 會自動產生)
STAGE_LINK_TOKEN=

# 網路搜尋用 Tavily(選用;https://app.tavily.com 申請。有填就預設用 Tavily,沒填用 DuckDuckGo)
TAVILY_API_KEY=

# 資料庫(只支援 SQLite):sqlite:data/miyoria.db = 本機檔案(預設);memory:// = 不保存(測試用)
DATABASE_URL=sqlite:data/miyoria.db
