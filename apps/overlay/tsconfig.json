{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    // The feed contract is read as types only, straight from source (no build step in between).
    "paths": {
      "@miyoria/contracts/overlay": ["../../packages/contracts/overlay/src/index.ts"]
    }
  },
  "include": ["src", "test", "vite.config.ts"]
}
